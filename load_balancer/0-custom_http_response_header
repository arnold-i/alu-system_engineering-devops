#!/usr/bin/env bash
# Configures a new Ubuntu machine with Nginx and adds a custom
# X-Served-By HTTP response header containing the server's hostname
# shellcheck disable=SC2154

sudo apt-get -y update
sudo apt-get -y install nginx

sudo mkdir -p /var/www/html
echo "Hello World!" | sudo tee /var/www/html/index.html > /dev/null

if ! grep -q "X-Served-By" /etc/nginx/sites-available/default; then
sudo sed -i 's/server_name _;/server_name _;\n\tadd_header X-Served-By $hostname;/' /etc/nginx/sites-available/default
fi

sudo nginx -t
sudo service nginx restart
